#!/bin/bash

echo "🛠️  Sistema Completo de Cheatsheets"
echo "=================================="
echo ""
echo "📖 VER CHEATSHEETS:"
echo "  cs                     Abrir hub de acciones y cheatsheets"
echo "  cs <herramienta>       Ver cheatsheet específico"
echo "  csfind                 Buscar nombres, comandos y descripciones"
echo "  /                      Dentro de un cheatsheet, abrir búsqueda contextual"
echo ""
echo "✨ CREAR NUEVOS CHEATSHEETS:"
echo "  csnew <herramienta>    Crear cheatsheet nuevo desde cero"
echo ""
echo "➕ AGREGAR COMANDOS:"
echo "  csadd <herramienta>    Agregar comandos a cheatsheet existente"
echo "                         • Puedes agregar múltiples comandos de una vez"
echo "                         • Pide nombre, comando y descripción"
echo "                         • Se abre automáticamente para verificar"
echo ""
echo "✏️  EDITAR COMANDOS:"
echo "  csedit <herramienta>   Editar comandos existentes interactivamente"
echo "                         • Selecciona comando por número"
echo "                         • Modifica nombre, comando y descripción"
echo ""
echo "🗑️  ELIMINAR COMANDOS:"
echo "  csdel <herramienta>    Eliminar comandos específicos"
echo "                         • Selección múltiple: 1,3,5"
echo "                         • Rangos: 1-3,5,7-9"
echo "                         • Limpia secciones vacías automáticamente"
echo ""
echo "🔧 ALIASES VIVOS:"
echo "  csalias                Agregar alias que funcionan inmediatamente"
echo "                         • Se agregan al cheatsheet"
echo "                         • Se agregan a tu configuración de fish"
echo "                         • Pide nombre, comando y descripción"
echo ""
echo "❓ AYUDA:"
echo "  cshelp                 Mostrar esta ayuda"
echo "  <comando>              Ejecutar sin parámetros muestra ayuda específica"
echo ""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
echo "📚 CHEATSHEETS DISPONIBLES:"
ls -1 "$SCRIPT_DIR"/*.md 2>/dev/null | sed 's|.*/||' | sed 's/\.md$//' | sed 's/^/  - /' | head -10

if [ $(ls -1 "$SCRIPT_DIR"/*.md 2>/dev/null | wc -l) -gt 10 ]; then
    echo "  ... y más"
fi

echo ""
echo "💡 TIPS:"
echo "  • Todos los comandos abren el cheatsheet automáticamente después de modificarlo"
echo "  • Cada registro guarda nombre, comando y descripción"
echo "  • Las categorías se asignan automáticamente según palabras clave"
echo "  • Los emojis se eligen inteligentemente según el tipo de comando"
echo "  • ✨ Formateo automático de teclas: 'ctrl alt t' → 'Ctrl + Alt + T'"
echo "  • Soporta: ctrl/cmd/alt/shift/fn + teclas especiales + letras/números"
echo ""

#!/bin/bash

# Wrapper script for delete_cheat.py
# Usage: csdel <tool_name>

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="$SCRIPT_DIR/delete_cheat.py"

if [ $# -eq 0 ]; then
    echo "🗑️  Eliminar comandos de cheatsheet existente"
    echo ""
    echo "Uso: csdel <nombre_herramienta>"
    echo ""
    echo "Ejemplos:"
    echo "  csdel git"
    echo "  csdel docker"
    echo "  csdel kubectl"
    echo ""
    echo "Características:"
    echo "  • Selección múltiple: 1,3,5"
    echo "  • Rangos: 1-3,5,7-9"
    echo "  • Limpieza automática de secciones vacías"
    echo "  • Confirmación antes de eliminar"
    echo ""
    echo "📚 Cheatsheets disponibles:"
    ls -1 "$SCRIPT_DIR"/*.md 2>/dev/null | sed 's|.*/||' | sed 's/\.md$//' | sed 's/^/  - /' | head -10
    exit 1
fi

python3 "$PYTHON_SCRIPT" "$@"